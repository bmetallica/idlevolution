# ── Datenbank ────────────────────────────────────────────────
POSTGRES_DB=idlevolution
POSTGRES_USER=idle
POSTGRES_PASSWORD=change-me

# ── App ──────────────────────────────────────────────────────
APP_PORT=8420
TICK_SECONDS=5
PERSIST_EVERY_TICKS=12
OFFLINE_CAP_HOURS=24

# Token, mit dem der ai-worker (und nur er) /api/ai/* aufrufen darf
AI_IMPORT_TOKEN=change-me-too

# ── Lokaler LLM-Server (llama.cpp / llama-swap) ──────────────
LLM_BASE_URL=http://localhost:8080
LLM_MODEL=gemma4-12b
# Nur Startwert/Fallback: Das tatsächliche Kontextfenster wird beim Server
# erfragt, weil ein zu hoher Wert still zu leeren Antworten führt (max_tokens
# wird serverseitig gekappt, das Modell läuft mitten im Satz aus).
LLM_CTX=16384
# Obergrenze der Ausgabe; effektiv zusätzlich durch (n_ctx − Prompt) gedeckelt.
LLM_MAX_TOKENS=12288
LLM_TEMPERATURE=0.7
# Reasoning ("<think>"). Standard aus: Für JSON-Generierung kostet es nur
# Ausgabebudget — die Grammatik erzwingt die Struktur ohnehin. true = an.
LLM_THINKING=false
# Modell-Routing pro Rolle (optional, llama-swap kann mehrere Modelle hosten):
# Nightly = groß/Qualität (Content-Generierung), Chat = klein/schnell (Berater, Strategist, Quests)
# Kontextfenster vor der Wahl prüfen — der Nacht-Prompt braucht ~7k Tokens plus Ausgabe.
#LLM_MODEL_NIGHTLY=gemma4-26b
#LLM_MODEL_CHAT=gemma4-12b

# Obergrenze des Spielstand-Exports im Nacht-Prompt (Tokens). Der Spielstand
# wächst unbegrenzt — dieser Deckel verengt notfalls die Detailtiefe auf die
# jüngsten Epochen, statt das Kontextfenster zu sprengen.
AI_EXPORT_TOKEN_BUDGET=6000

# ── Optionaler Schreibschutz der Spiel-API ───────────────────
# Gesetzt → alle schreibenden /api-Aufrufe brauchen den Header x-game-token.
# Im Browser einmalig hinterlegen: localStorage.setItem('gameToken', '…')
# Standard: leer = aus (LAN-Betrieb bleibt frei).
#GAME_TOKEN=

# Nächtliche Generierung (Cron-Syntax) + sofortiger Lauf beim Start (Debug)
AI_CRON=0 3 * * *
AI_RUN_ON_START=false

# ── Online-Multiplayer über GitHub (optional) ────────────────
# Client-ID der GitHub-OAuth-App (Device Flow, öffentlich — kein Secret nötig).
# Standard ist die offizielle Idlevolution-App; eigene App nur für Forks nötig.
#ONLINE_CLIENT_ID=Ov23lih2yPEXcAEKwEc3
# Community-Repo, in dem Inseln veröffentlicht/gelesen werden
#ONLINE_REPO=bmetallica/idlevolution-online
